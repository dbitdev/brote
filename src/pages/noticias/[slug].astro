---
import Layout from "../../layouts/Layout.astro";
import { articles, formatDate } from "../../data/articles.js";
import { routes } from "../../data/site.js";

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.excerpt,
  image: new URL(article.image, Astro.site).href,
  datePublished: article.date,
  inLanguage: "es-MX",
  author: { "@type": "Organization", name: "Brote" },
  publisher: { "@type": "Organization", name: "Brote", logo: { "@type": "ImageObject", url: new URL("/assets/media/brote-logo-petroleo.png", Astro.site).href } },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Layout title={article.title} description={article.excerpt} image={article.image} bodyClass="single single-post" schema={schema}>
  <div class="archive-index">
    <section id="post-hero" class="with-thumbnail" style={`background: url(${article.image}) center center / cover no-repeat;`}>
      <div class="overlay"></div>
      <div class="inner-section">
        <h1>{article.title}</h1>
        <div class="post-categories">{article.category} · {formatDate(article.date)}</div>
      </div>
    </section>
    <div class="progressPanelContainer"><div class="progressPanel"><span class="progress"></span></div></div>
    <div class="grid-container page-container blog">
      <div class="inner-section">
        <div class="top-content">
          <div class="content col-7" set:html={article.body} />
          <div class="col-3">
            <div class="sharing-default-minimal share-desktop">
              <p class="upper-title">Compartir:</p>
              <div class="social">
                <a class="facebook-share" href="#" title="Compartir en Facebook" aria-label="Facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
                </a>
                <a class="twitter-share" href="#" title="Compartir en X" aria-label="X">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 2l7.6 9.6L3 22h1.9l6.6-7.4 5.5 7.4H23l-8.2-10.9L22 2h-1.9l-6.1 6.8L9 2Z"/></svg>
                </a>
                <a class="linkedin-share" href="#" title="Compartir en LinkedIn" aria-label="LinkedIn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
                </a>
                <a class="mail" href={`mailto:?subject=${encodeURIComponent(article.title)}`} aria-label="Correo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
        <p style="margin-top: 40px;"><a class="no-shape light" href={routes.noticias}>Volver a noticias</a></p>
      </div>
    </div>
  </div>
</Layout>
