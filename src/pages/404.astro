---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página no encontrada" bodyClass="error404" headerTheme="dark" noindex>
  <section class="error-404 not-found center" style="padding: 220px 20px 120px; text-align: center;">
    <h1>Página no encontrada</h1>
    <p>La página que buscas no existe o cambió de dirección.</p>
    <p><a class="no-shape light" href="/">Volver al inicio</a></p>
  </section>
</Layout>
