---
// Fila 50/50 con imagen enmascarada. side="left" pone la imagen a la izquierda.
const { id, side = "left", image, alt = "", eyebrow, link, linkLabel = "Aprende más", padding = 60 } = Astro.props;
const pattern = side === "left" ? "/assets/img/50-pattern-left.svg" : "/assets/img/50-pattern-right.svg";
---
<section id={id} class={`split-row_50 ${side}`} style={`padding-top:${padding}px;padding-bottom:${padding}px;`}>
  <div class="inner-section">
    <div class="image-wrapper">
      <img uk-parallax="y: -70, 20" src={pattern} alt="" class="lines-pattern" />
      <img uk-parallax="y: -70, 20" src={image} alt={alt ?? ""} loading="lazy" width="1920" height="1080" />
    </div>
    <div class="content" uk-scrollspy="cls: uk-animation-fade; repeat: false;">
      {eyebrow && <p class="upper-title">{eyebrow}</p>}
      <slot />
      {link && <a class="no-shape light" href={link}>{linkLabel}</a>}
    </div>
  </div>
</section>
