---
import { footerWhatWeDo, footerSitemap, routes, site } from "../data/site.js";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <img class="footer-desktop-wave" src="/assets/img/footer-wave-desktop.svg" alt="" />
  <img class="footer-mobile-wave" src="/assets/img/footer-wave-mobile.svg" alt="" />
  <div class="container">
    <div class="newsletter_form">
      <div class="footer-headline">
        <h3>Recibe las <span class="verde">novedades del campo</span>.<br />Suscríbete hoy.</h3>
      </div>
      <div class="newsletter-wrapper">
        <div role="form" class="wpcf7" lang="es-MX">
          <form class="wpcf7-form init brote-form" novalidate>
            <div class="col-1">
              <label>
                <span class="label">Tu correo electrónico</span>
                <span class="wpcf7-form-control-wrap your-email"><input type="email" name="email" required size="40" class="wpcf7-form-control wpcf7-text wpcf7-email" /></span>
              </label>
              <div class="beck-submit"><input type="submit" value="Suscribirme" class="wpcf7-form-control wpcf7-submit" /></div>
            </div>
            <div class="wpcf7-response-output" aria-hidden="true"></div>
          </form>
        </div>
      </div>
    </div>
    <div class="footer-columns">
      <div class="footer-column__logo">
        <a href="/"><img src="/assets/media/brote-bg.png" width="200" alt="Brote Ag" /></a>
      </div>
      <div class="footer-column">
        <div class="footer-column-inner footer-widget">
          <section class="widget widget_nav_menu">
            <ul class="menu">
              <li class="menu-item menu-item-has-children"><a href="#">Qué hacemos</a>
                <ul class="sub-menu">
                  {footerWhatWeDo.map((l) => <li class="menu-item"><a href={l.href}>{l.label}</a></li>)}
                </ul>
              </li>
            </ul>
          </section>
        </div>
      </div>
      <div class="footer-column">
        <div class="footer-column-inner footer-widget">
          <section class="widget widget_nav_menu">
            <ul class="menu">
              {footerSitemap.map((l) => <li class="menu-item"><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </section>
          <section class="widget widget_block">
            <section class="social-media-section" style="padding-top: 30px; padding-bottom: 30px;">
              <div class="inner-section">
                <div class="social-media">
        <div class="icon">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Brote en Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#00c65e"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
          </a>
        </div>
                </div>
              </div>
            </section>
          </section>
        </div>
      </div>
    </div>
  </div>
  <div class="copyright">
    <div class="footer-site-by">
      <p>©{year} </p><div style="width: 5px"></div>
      <p>Brote Ag. Impulsando el campo mexicano. <span class="verde">/</span> <a href={routes.privacidad}>Aviso de privacidad</a></p>
    </div>
    <hr />
  </div>
</footer>
